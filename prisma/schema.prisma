generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Branch {
  CSE
  CSM
  EEE
  ECE
  MECHANICAL
  CIVIL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProgressStatus {
  NOT_STARTED
  QUALIFIED
  ELIMINATED
}

enum TeamStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ELIMINATED
  FINALIST
  WINNER
  RUNNER_UP
}

enum ResultStatus {
  QUALIFIED
  ELIMINATED
  FINALIST
  WINNER
  RUNNER_UP
}

model Admin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
}

model Participant {
  id String @id @default(cuid())
  registrationId String @unique
  fullName String
  rollNumber String @unique
  collegeEmail String @unique
  phoneNumber String
  branch Branch
  section String?
  year Int @default(3)
  collegeIdUrl String
  collegeIdFileName String
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason String?
  currentRound Int @default(1)
  round1Status ProgressStatus @default(NOT_STARTED)
  round2Status ProgressStatus @default(NOT_STARTED)
  round1Score Float?
  round2Score Float?
  registeredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  teamMembership TeamMember?
  results Result[]
}

model Team {
  id String @id @default(cuid())
  teamNumber Int @unique
  teamName String @unique
  status TeamStatus @default(DRAFT)
  published Boolean @default(false)
  score Float?
  rank Int?
  members TeamMember[]
  results Result[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id String @id @default(cuid())
  teamId String
  participantId String @unique
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  @@unique([teamId, participantId])
}

model Announcement {
  id String @id @default(cuid())
  title String
  content String
  isPinned Boolean @default(false)
  isPublished Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JuryMember {
  id String @id @default(cuid())
  name String
  designation String
  photoUrl String?
  organization String?
  department String?
  bio String?
  displayOrder Int @default(0)
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Result {
  id String @id @default(cuid())
  round Int
  participantId String?
  teamId String?
  score Float?
  rank Int?
  status ResultStatus?
  remarks String?
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@index([round, published])
}

model EventSettings {
  id String @id @default(cuid())
  eventName String @default("CODETHON 2026")
  organizer String @default("Abhiruchi Club")
  institution String @default("Mother Teresa Institute of Science and Technology")
  eventDate DateTime @default("2026-10-14T04:30:00.000Z")
  startTime String @default("10:00 AM")
  endTime String @default("10:00 PM")
  registrationDeadline DateTime @default("2026-10-13T18:29:00.000Z")
  codeTantraUrl String?
  contactEmail String?
  registrationEnabled Boolean @default(true)
  resultsPublished Boolean @default(false)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())
  action String
  entity String
  entityId String?
  metadata String?
  createdAt DateTime @default(now())
}
